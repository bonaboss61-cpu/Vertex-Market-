# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AQ.Ab8RN6LynN1ySBME3UATe5uTB8-nsvGmC33cOli_5cQ7cBB9XQ"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FLUTTERWAVE GATEWAY API KEYS (Live/Test)
# Obtain these from your Flutterwave dashboard: Settings > API Keys
FLW_PUBLIC_KEY="FLWPUBK-3cadf19919b39dfd262e6bb87ac6da9e-X"
FLW_SECRET_KEY="FLWSECK-2e793f807222ab36161a472ae30a3c7b-19f60e3a6b0vt-X"

# GMAIL CONFIGURATION (For sending OTP Verification Emails)
# You need a Gmail App Password, NOT your regular password.
# 1. Go to your Google Account > Security
# 2. Enable 2-Step Verification
# 3. Search for "App Passwords" and create one.
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-digit-app-password"

# CLOUD SQL POSTGRESQL VARIABLES
# Automatically injected by AI Studio when Cloud SQL is provisioned.
PGHOST="localhost"
PGDATABASE="postgres"
PGUSER="postgres"
PGPASSWORD="password"

# FIREBASE CONFIGURATION
# Firebase credentials are NOT stored here. They are automatically managed 
# via the `firebase-applet-config.json` file in the root directory.
VITE_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
